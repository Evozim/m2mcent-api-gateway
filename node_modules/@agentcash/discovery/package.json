{
  "name": "@agentcash/discovery",
  "version": "1.7.5",
  "description": "Canonical OpenAPI-first discovery runtime for the agentcash ecosystem",
  "homepage": "https://github.com/merit-systems/agentcash-discovery#readme",
  "bugs": {
    "url": "https://github.com/merit-systems/agentcash-discovery/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schemas": {
      "import": {
        "types": "./dist/schemas.d.ts",
        "default": "./dist/schemas.js"
      },
      "require": {
        "types": "./dist/schemas.d.cts",
        "default": "./dist/schemas.cjs"
      }
    }
  },
  "files": [
    "dist",
    "bin",
    "docs",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agentcash",
    "agentic-commerce",
    "discovery",
    "x402",
    "mpp",
    "openapi",
    "payments",
    "agents"
  ],
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/merit-systems/agentcash-discovery"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "dereference-json-schema": "^0.2.2",
    "neverthrow": "^8.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.19",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.4.0",
    "knip": "^5.88.1",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts' 'scripts/**/*.mjs' '*.json' '*.mjs' '*.md'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts' 'scripts/**/*.mjs' '*.json' '*.mjs' '*.md'",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:registry": "pnpm build && node scripts/audit-registry.mjs",
    "audit:registry:quick": "pnpm build && node scripts/audit-registry.mjs --origin-limit 50 --resource-limit 500",
    "knip": "knip",
    "check": "pnpm format:check && pnpm lint && pnpm knip && pnpm typecheck && pnpm build && pnpm test"
  },
  "bin": {
    "discovery": "./bin/discovery.js"
  }
}